#!/bin/sh
# Quiet pre-commit gate: each gate's output is shown only when it fails.
set -e

if ! output=$(gofmt -l . 2>&1) || [ -n "$output" ]; then
  printf '\npre-commit: gofmt -l . failed\n\n%s\n' "$output"
  exit 1
fi

for gate in "go vet ./..." "go test ./..."; do
  if ! output=$($gate 2>&1); then
    printf '\npre-commit: %s failed\n\n%s\n' "$gate" "$output"
    exit 1
  fi
done
